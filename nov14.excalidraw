    {
      "id": "A5F-TXnML5y1yNOCkfXQd",
      "type": "text",
      "x": 3340.9676467800755,
      "y": 4621.403096713746,
      "width": 800,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3m",
      "roundness": null,
      "seed": 978338534,
      "version": 7,
      "versionNonce": 1340578598,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1794569638826,
      "created": 1794569176914,
      "link": null,
      "locked": false,
      "text": "SELECT\n    BIN_TO_UUID(l.id)               AS location_id,\n    l.enabled,\n    l.enable_requested,\n    BIN_TO_UUID(l.business_unit_id) AS business_unit_id,\n    BIN_TO_UUID(bu.sub_merchant_id) AS sub_merchant_id\nFROM payfac_submerchant.location l\nJOIN payfac_submerchant.business_unit bu ON bu.id = l.business_unit_id\nWHERE l.id = UUID_TO_BIN('15c04891-9765-4f17-a16c-aaf143c2db88');\n\nAnd to double check the business unit itself actually exists (in case the location row is\nmissing entirely, like it was in QA):\n\nSELECT\n    BIN_TO_UUID(id) AS business_unit_id,\n    BIN_TO_UUID(sub_merchant_id) AS sub_merchant_id\nFROM payfac_submerchant.business_unit\nWHERE id = UUID_TO_BIN('772f78df-5955-4a02-8a52-5bb932707834');",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SELECT\n    BIN_TO_UUID(l.id)               AS location_id,\n    l.enabled,\n    l.enable_requested,\n    BIN_TO_UUID(l.business_unit_id) AS business_unit_id,\n    BIN_TO_UUID(bu.sub_merchant_id) AS sub_merchant_id\nFROM payfac_submerchant.location l\nJOIN payfac_submerchant.business_unit bu ON bu.id = l.business_unit_id\nWHERE l.id = UUID_TO_BIN('15c04891-9765-4f17-a16c-aaf143c2db88');\n\nAnd to double check the business unit itself actually exists (in case the location row is missing entirely, like it was in QA):\n\nSELECT\n    BIN_TO_UUID(id) AS business_unit_id,\n    BIN_TO_UUID(sub_merchant_id) AS sub_merchant_id\nFROM payfac_submerchant.business_unit\nWHERE id = UUID_TO_BIN('772f78df-5955-4a02-8a52-5bb932707834');",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
