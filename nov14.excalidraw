    },
    {
      "id": "82ek0gsfRH9irq5FqhnRY",
      "type": "text",
      "x": -3867.660784944002,
      "y": -290.72299435828063,
      "width": 709.8994750976562,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2P",
      "roundness": null,
