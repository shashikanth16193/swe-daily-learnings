    },
    {
      "id": "mdkt8vy2ZSPEojFJUUPvM",
      "type": "text",
      "x": -24974.60758417773,
      "y": -4554.633567164325,
      "width": 680.0192260742188,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5s",
      "roundness": null,
      "seed": 1644014010,
      "version": 314,
      "versionNonce": 954266214,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794651781475,
      "created": 1794636644412,
      "link": null,
      "locked": false,
      "text": "usage \nexport MY_API_KEY=\"your-secret-key\"\nit is command but it will be store in the current terminal\nsession\n\n\nvi  ~/.zshrc\nopen and paste command into start up file\n\nsource ~/.zshrc\nit makes temrinal refresh and load file\ninstead close and open terminal\n\nechoing small propety without opening file at all \n\necho 'export MY_API_KEY=\"your-secret-key\"' >> ~/.zshrc && source ~/.zshrc\n\n&& to execute multiple commands at a time\n| to pipe output of a command as input to next command\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "usage \nexport MY_API_KEY=\"your-secret-key\"\nit is command but it will be store in the current terminal\nsession\n\n\nvi  ~/.zshrc\nopen and paste command into start up file\n\nsource ~/.zshrc\nit makes temrinal refresh and load file\ninstead close and open terminal\n\nechoing small propety without opening file at all \n\necho 'export MY_API_KEY=\"your-secret-key\"' >> ~/.zshrc && source ~/.zshrc\n\n&& to execute multiple commands at a time\n| to pipe output of a command as input to next command\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
