      "updated": 1794638742304,
      "created": 1794574217528,
      "link": null,
      "locked": false,
      "text": "-- Staging: has onboarding even started for this live business unit?\nSELECT BIN_TO_UUID(lo.id), BIN_TO_UUID(lo.location_id), lo.name, lo.date_created\nFROM payfac_onboarding.location_onboarding lo\nJOIN payfac_onboarding.business_unit_onboarding buo ON buo.id = lo.business_unit_id\nWHERE buo.business_unit_id = UUID_TO_BIN('<business-unit-uuid>');",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-- Staging: has onboarding even started for this live business unit?\nSELECT BIN_TO_UUID(lo.id), BIN_TO_UUID(lo.location_id), lo.name, lo.date_created\nFROM payfac_onboarding.location_onboarding lo\nJOIN payfac_onboarding.business_unit_onboarding buo ON buo.id = lo.business_unit_id\nWHERE buo.business_unit_id = UUID_TO_BIN('<business-unit-uuid>');",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2ZfLqN9fqGdXuyv-Q652m",
      "type": "rectangle",
      "x": -27116.703820315506,
