    {
      "id": "TNbUfowhzIiySRJUMRHgq",
      "type": "text",
      "x": -23980.624423976467,
      "y": -4574.330722764331,
      "width": 800,
      "height": 750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b4r",
      "roundness": null,
      "seed": 412473914,
      "version": 883,
      "versionNonce": 605235430,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794651781475,
      "created": 1794634262626,
      "link": null,
      "locked": false,
      "text": "\nuser logs in to cloud console or claude console or atlasian using user name and\npassword\n\nbut to make some software program to login into these consoles on behalf of us\nwe cant directly give our password to these software program \n\nThus 3rd party apps provide and store  api key linked to single user and thier\npermissions  in their databse \nwe can use our api key in our software programs to make our software program gets\naccess to cloud console and so on\n\nsetup :- every 3rd party console has api key feature get the api key and store in\nenvironment file for future session or use export command to store only for current\nterminal sessions\nand they dont expire until we revoke it\n\n\nUsage\n\nvi ~/.zshrc\nexport ANTHROPIC_API_KEY=mykey\n:wq\n\nprject specific environment variables \nvi my-repo/.env\nadd all keys in .env file but must load .env file everytime\n\nvi .gitignore\nadd .env file to  to gitignore so git wont track env file at all",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nuser logs in to cloud console or claude console or atlasian using user name and password\n\nbut to make some software program to login into these consoles on behalf of us\nwe cant directly give our password to these software program \n\nThus 3rd party apps provide and store  api key linked to single user and thier permissions  in their databse \nwe can use our api key in our software programs to make our software program gets access to cloud console and so on\n\nsetup :- every 3rd party console has api key feature get the api key and store in environment file for future session or use export command to store only for current terminal sessions\nand they dont expire until we revoke it\n\n\nUsage\n\nvi ~/.zshrc\nexport ANTHROPIC_API_KEY=mykey\n:wq\n\nprject specific environment variables \nvi my-repo/.env\nadd all keys in .env file but must load .env file everytime\n\nvi .gitignore\nadd .env file to  to gitignore so git wont track env file at all",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
