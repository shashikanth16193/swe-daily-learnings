      "text": "gradle jib\nstacks mmpay service jar\non the base image with CVE=0\nand commits fresh image tag to ECR\nand gitops repo",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "gradle jib\nstacks mmpay service jar\non the base image with CVE=0\nand commits fresh image tag to ECR\nand gitops repo",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "82ek0gsfRH9irq5FqhnRY",
      "type": "text",
      "x": -3867.660784944002,
      "y": -290.72299435828063,
      "width": 709.8994750976562,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2P",
      "roundness": null,
      "seed": 514964794,
      "version": 368,
      "versionNonce": 1025879526,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794638742303,
      "created": 1794550798206,
      "link": null,
      "locked": false,
      "text": "Note: when PR is merged and next release jenkins build trigger \njib plugin tries to pull image from infosec but there is no image matching \nthe digest so it pulls from chain gaurd regstry and again image is stored\nin the pull through cache of info sec",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Note: when PR is merged and next release jenkins build trigger \njib plugin tries to pull image from infosec but there is no image matching \nthe digest so it pulls from chain gaurd regstry and again image is stored\nin the pull through cache of info sec",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
