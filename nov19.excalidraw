    {
      "id": "GUkT233N_HXR0rEuI71tm",
      "type": "rectangle",
      "x": -33772.009098143855,
      "y": -3738.9130553844698,
      "width": 2160.5078125,
      "height": 2561.8359375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
